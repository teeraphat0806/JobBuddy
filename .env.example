# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Local: docker compose up -d
# Railway: reference the Postgres service variable -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://jobbuddy:jobbuddy@localhost:5432/jobbuddy

# LINE Developers Console -> your Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

APP_TIMEZONE=Asia/Bangkok

# Create/update the LINE rich menu on startup (needs a real access token)
RICH_MENU_SYNC=false

# Pull jobs from company job boards (Greenhouse / Lever / SmartRecruiters)
JOB_SYNC=true
JOB_SYNC_INTERVAL_HOURS=6
# Interview reminders are LINE push messages (count against the monthly quota)
REMINDERS=true
REMINDER_INTERVAL_MINUTES=5
